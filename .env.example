# ─────────────────────────────────────────────────────────────────────────────
# Qraya backend — every option here is FREE. Fill in ONE of the keys below.
# Nothing is required: with no key the site still works using the built-in
# on-device question engine. A key upgrades it to real AI generation.
# ─────────────────────────────────────────────────────────────────────────────

# RECOMMENDED — Google Gemini. Free tier, no credit card.
# 1. https://aistudio.google.com/apikey  → "Create API key"
# 2. paste it here
GEMINI_API_KEY=

# Optional: pin a model instead of auto-detecting (leave empty normally).
# LLM_MODEL=gemini-2.5-flash

# ── Alternative free providers (use at most one) ─────────────────────────────
# Groq — free tier, very fast: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — free `:free` models: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI (paid, supported for completeness)
OPENAI_API_KEY=

# ── Any other OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, Together…) ─
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ── Tuning (optional) ────────────────────────────────────────────────────────
# LLM_PROVIDER=gemini            # force one provider when several keys are set
# LLM_CONCURRENCY=1              # parallel model calls; keep 1 on free tiers
# LLM_TIMEOUT_MS=110000
# MAX_TEXT_CHARS=120000          # reject larger course texts
# MAX_QUESTIONS=30
# QUIZ_BATCH_SIZE=8
# RATE_IP_PER_HOUR=30
# RATE_IP_PER_DAY=120
# FREE_DAILY_LIMIT=0             # global daily AI calls, 0 = unlimited
